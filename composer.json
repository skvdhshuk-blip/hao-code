{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sk-wang/hao-code",
    "version": "v0.4.0",
    "type": "library",
    "description": "Terminal-first AI coding agent and PHP SDK for Anthropic, OpenAI Responses, and OpenAI Chat Completions APIs.",
    "keywords": ["ai", "agent", "cli", "coding-agent", "sdk", "anthropic", "openai"],
    "homepage": "https://github.com/sk-wang/hao-code",
    "license": "MIT",
    "bin": ["bin/hao-code"],
    "require": {
        "php": "^8.1",
        "illuminate/translation": "^10.48 || ^11.0 || ^12.0",
        "illuminate/validation": "^10.48 || ^11.0 || ^12.0",
        "laravel-zero/framework": "^10.0 || ^11.0 || ^12.0",
        "league/commonmark": "^2.4",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/sem-conv": "^1.0",
        "symfony/clock": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/string": "^6.4 || ^7.0",
        "symfony/translation": "^6.4 || ^7.0"
    },
    "require-dev": {
        "illuminate/database": "^10.48 || ^11.0 || ^12.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "HaoCode\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:live": "phpunit --group live",
        "lint": "pint --test",
        "fix": "pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "HaoCode\\Sdk\\HaoCodeSdkServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "support": {
        "issues": "https://github.com/sk-wang/hao-code/issues",
        "source": "https://github.com/sk-wang/hao-code"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
