{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sk-wang/hao-code",
    "type": "library",
    "description": "PHP agent SDK for Anthropic, OpenAI Responses, and OpenAI Chat Completions APIs.",
    "keywords": ["ai", "agent", "agent-sdk", "sdk", "anthropic", "openai"],
    "homepage": "https://github.com/skvdhshuk-blip/hao-code",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "open-telemetry/sem-conv": "^1.0",
        "swaggest/json-schema": "^0.12.43",
        "symfony/clock": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "files": [
            "app/Support/Runtime/helpers.php"
        ],
        "psr-4": {
            "HaoCode\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/hao-code-sandbox"
    ],
    "scripts": {
        "test": "@test:full",
        "quality:aggregate-size": "php scripts/php-aggregate-size-check.php",
        "quality:dependency-direction": "php scripts/runtime-dependency-check.php",
        "quality:file-size": "php scripts/php-file-size-check.php",
        "test:discover": "php scripts/test-discovery-check.php",
        "test:full": [
            "@quality:file-size",
            "@quality:aggregate-size",
            "@quality:dependency-direction",
            "@test:discover",
            "php -d memory_limit=-1 vendor/bin/phpunit --exclude-group live --no-progress"
        ],
        "test:live": "php -d memory_limit=-1 vendor/bin/phpunit --group live",
        "lint": "find app tests examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "suggest": {
        "ext-sqlite3": "For daemon mode (cron job persistence via SQLite)",
        "ext-pdo_sqlite": "Required for durable run-state recovery and daemon SQLite storage",
        "ext-pcntl": "Required for daemon signal handling (SIGTERM/SIGINT)",
        "ext-posix": "Required for daemon PID management and stale-pid detection"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "support": {
        "issues": "https://github.com/skvdhshuk-blip/hao-code/issues",
        "source": "https://github.com/skvdhshuk-blip/hao-code"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
